# First we have the build layer

# Global args
ARG BASE_IMAGE=ros
ARG BASE_TAG=jazzy-ros-base
ARG DISTRO=jazzy

FROM osrf/ros:jazzy-desktop-full AS builder
ARG DISTRO
ARG BUILD_DIR=/build_dir
WORKDIR ${BUILD_DIR}
COPY  ./src/test_pkg ./src/test_pkg

# Write the source command to the .bashrc to ensure ROS environment is set up for the user
RUN echo "source /opt/ros/${DISTRO}/setup.bash" >> ~/.bashrc

RUN apt-get update && apt-get install -y \
    python3-pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies for the test package
RUN pip3 install --user --break-system-packages --no-cache-dir \
    pydantic \
    paho-mqtt \
    PyYAML \
    lark \
    empy \
    numpy \
    catkin_pkg

SHELL ["/bin/bash", "-c"]

RUN source /opt/ros/${DISTRO}/setup.bash && \
    colcon build

FROM ${BASE_IMAGE}:${BASE_TAG}

# These have to be redeclared in the second stage to be used in this stage
# https://stackoverflow.com/questions/53681522/share-variable-in-multi-stage-dockerfile-arg-before-from-not-substituted
ARG BASE_IMAGE
ARG BASE_TAG
ARG DISTRO

ENV DEBIAN_FRONTEND=noninteractive

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=${USER_UID}
ARG WORKSPACE=test_ws

RUN apt-get update && apt-get install -y \
    nano \
    python3-pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN if ! id -u "${USERNAME}" >/dev/null 2>&1; then \
        if ! getent group "${USERNAME}" >/dev/null 2>&1; then \
            if getent group "${USER_GID}" >/dev/null 2>&1; then \
                groupadd "${USERNAME}"; \
            else \
                groupadd --gid "${USER_GID}" "${USERNAME}"; \
            fi; \
        fi; \
        if getent passwd "${USER_UID}" >/dev/null 2>&1; then \
            useradd --gid "${USERNAME}" -m -s /bin/bash "${USERNAME}"; \
        else \
            useradd --uid "${USER_UID}" --gid "${USERNAME}" -m -s /bin/bash "${USERNAME}"; \
        fi; \
    fi

USER ${USERNAME}

ENV HOME=/home/${USERNAME}
ENV USER=${USERNAME}

WORKDIR /home/${USERNAME}/${WORKSPACE}
RUN echo ${WORKSPACE}
COPY  --from=builder /build_dir/install ./install

# Write the source command to the .bashrc to ensure ROS environment is set up for the user
RUN echo "source /opt/ros/${DISTRO}/setup.bash" >> ~/.bashrc

# Install python dependencies for the test package
RUN pip3 install --user --break-system-packages --no-cache-dir \
    pydantic \
    paho-mqtt \
    PyYAML \
    lark \
    empy \
    numpy \
    catkin_pkg

# Use bash as the default shell for subsequent commands
# because sh does not understand source
SHELL ["/bin/bash", "-c"]

RUN source /opt/ros/${DISTRO}/setup.bash

#RUN echo "if [ -f ~/${WORKSPACE}/install/setup.bash ]; then source ~/${WORKSPACE}/install/setup.bash; fi" >> ~/.bashrc

ENTRYPOINT ["bash"]
#CMD ["bash"]