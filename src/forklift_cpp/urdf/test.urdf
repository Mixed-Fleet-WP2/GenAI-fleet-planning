      <joint_name>right_wheel_back_joint</joint_name>
      <joint_name>fork_attach_1_joint</joint_name>
      <joint_name>fork_attach_2_joint</joint_name>
      <joint_name>fork_1_joint</joint_name>
      <joint_name>fork_2_joint</joint_name>
      <joint_name>fork_plate</joint_name>
      -->
      <!-- <joint_name>fork_plate</joint_name> -->
      <topic>/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fork_plate_joint</joint_name>
      <initial_position>0.0</initial_position>
      <topic>/fork_control</topic>
      <p_gain>40000</p_gain>
      <i_gain>2000</i_gain>
      <d_gain>5000</d_gain>
      <i_min>-2000</i_min>
      <i_max>2000</i_max>
      <cmd_min>-80000</cmd_min>
      <cmd_max>120000</cmd_max>
    </plugin>
  </gazebo>
