    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>fork_1</parent_link>
      <child_model>euro_pallet_2</child_model>
      <child_link>link</child_link>
      <detach_topic>/euro_pallet_2/detach</detach_topic>
      <attach_topic>/euro_pallet_2/attach</attach_topic>
      <output_topic>/euro_pallet_2/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <!--
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
