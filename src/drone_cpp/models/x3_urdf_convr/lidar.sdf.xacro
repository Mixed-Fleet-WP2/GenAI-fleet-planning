<?xml version="1.0" encoding="UTF-8"?>
  
  <!-- 
 
  Lidar model adapted from Lidar 2d v2-model by OpenRobotics

  Link to the original model: https://app.gazebosim.org/OpenRobotics/fuel/models/Lidar%202d%20v2

  Changes made: converted the original sdf to support xacro format and
  changed model:// references into package:// to support texture
  rendering in rviz2.

  License: Creative Commons Attribution 4.0 International
  Lisence link: https://creativecommons.org/licenses/by/4.0/

  -->

<sdf version='1.6' xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="link">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <pose>0 0 0.0435 0 0 0</pose>
      <mass>0.37</mass>
      <inertia>
        <ixx>0.00034437749999999994</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.00034437749999999994</iyy>
        <iyz>0</iyz>
        <izz>0.00022199999999999998</izz>
      </inertia>
    </inertial>
    <collision name="collision_base">
      <pose>0 0 0.0205 0 0 0</pose>
      <geometry>
        <box>
          <size>0.06 0.06 0.041</size>
        </box>
      </geometry>
    </collision>
    <collision name="collision_mid">
      <pose>0 0 0.055 0 0 0</pose>
      <geometry>
        <cylinder>
          <radius>0.025</radius>
          <length>0.028</length>
        </cylinder>
      </geometry>
    </collision>
    <collision name="collision_top">
      <pose>0 0 0.078 0 0 0</pose>
      <geometry>
        <box>
          <size>0.056 0.056 0.018</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <mesh>
          <uri>package://drone_cpp/models/lidar_2d_v2/meshes/lidar_2d_v2.dae</uri>
        </mesh>
      </geometry>
    </visual>
    <sensor name="lidar_2d_v2" type="gpu_lidar">
      <pose>0 0 0.055 0 0 0</pose>
      <topic>$(arg namespace)/scan</topic>
      <gz_frame_id>link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-2.356195</min_angle>
            <max_angle>2.356195</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
      <always_on>0</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
    </sensor>
  </link>
</sdf>