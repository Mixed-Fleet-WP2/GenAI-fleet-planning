<?xml version='1.0' encoding='ASCII'?>
  
  <!-- 

  Warehouse model adapted from Warehouse-model by MovAI

  Link to the original model: https://app.gazebosim.org/MovAi/fuel/models/Warehouse

  Changes made: 
    - Added system plugins to support different sensors. 
    - Added additional models like a pallet to complement the simulation environment.
    - Removed actors, chairs and tables and some of the smaller shelves (numbers 1,2,3 and 4) and barriers
    - Changed the positions for the selves to make the warehouse more spacious for the forklift

  License under Apache 2.0 and Creative Commons Attribution 4.0 International (included models), 
  see LICENSES at the repository root for full license

  -->

<sdf version='1.7'>
  <world name='warehouse'>
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin> -->

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <!-- <surface>
            <contact>
              <collide_bitmask>0x02</collide_bitmask>
            </contact>
          </surface> -->
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Base -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Warehouse
      </uri>
      <name>warehouse</name>
      <pose>0 0 -0.1 0 0 0</pose>
    </include>

    <!--Old tutorial but still valid: https://classic.gazebosim.org/tutorials?tut=add_laser-->
    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://euro_pallet</uri>
      <name>euro_pallet_1</name>
      <pose>14.25 -10.0 0 0 0 0</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://euro_pallet</uri>
      <name>euro_pallet_2</name>
      <pose>-5.0 13.5 0 0 0 0</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://asset_pallet</uri>
      <name>asset_pallet_1</name>
      <pose>-14 3.25 0 0 0 0</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://asset_pallet</uri>
      <name>asset_pallet_2</name>
      <pose>11 24 0 0 0 1.57</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://pallet_rack</uri>
      <name>rack_1</name>
      <pose>-14 3.25 0 0 0 -1.57</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://pallet_rack</uri>
      <name>rack_2</name>
      <pose>1 -20 0 0 0 0</pose>
    </include>

    <include>
      <!--In order for gazebo to find this, an appropriate mode.config must exist-->
      <!--See setting environment variable in multi_robot_launch.py-->
      <uri>model://pallet_rack</uri>
      <name>rack_3</name>
      <size></size>
      <pose>11 24 0 0 0 3.14</pose>
    </include>

    <!-- Shelves -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_big_0</name>
      <pose>-8.5 -13 0 0 -0 0</pose>
    </include>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_big_1</name>
      <pose>9 -13 0 0 -0 0</pose>
    </include>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_big_2</name>
      <pose>-5 -13 0 0 -0 0</pose>
    </include>
  
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_big_3</name>
      <pose>0 9.5 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big
      </uri>
      <name>shelf_big_4</name>
      <pose>0 14 0 0 0 1.57</pose>
    </include>
   
    <!-- <include>
      <uri>
      https://fuel.gazebosim.org/1.0/OpenRobotics/models/MaleVisitorOnPhone
      </uri>
      <name>Person 1 - Standing</name>
      <pose>1 -1 0 0 0 1.57</pose>
    </include> -->

    <!-- <include>
      <uri>
      https://fuel.gazebosim.org/1.0/plateau/models/Casual female
      </uri>
      <name>Person 2 - Walking</name>
      <pose>-12 15 0 0 0 0</pose>
    </include> -->

  </world>
</sdf>
