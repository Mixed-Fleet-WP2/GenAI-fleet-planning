<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="forklift">

  <!-- JointStatePublisher publishes joint state information for the model.
         In future versions of Gazebo, replace 'ignition-gazebo' with 'gz-sim' and
         'ignition::gazebo' with 'gz::sim'
    -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
          <topic>joint_states</topic>
      </plugin>    
  </gazebo> 

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.8 0.6 0.25" />
      </geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <material name="red">
        <color rgba="1.0 0 0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.8 0.6 0.25" />
      </geometry>
    </collision>
    <inertial>
      <mass value="100.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- Cockpit Beam 1 -->
  <link name="cockpit_beam_1">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.53" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.53" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- Cockpit Beam 2 -->
  <link name="cockpit_beam_2">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.54" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.54" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- Cockpit Beam 3 -->
  <link name="cockpit_beam_3">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
       <box size="0.05 0.05 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- Roof -->
  <link name="roof">
    <visual>
      <geometry>
        <box size="0.3 0.48 0.03" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.48 0.03" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0" ixy="0.0" ixz="0.0" iyy="0" iyz="0.0" izz="0" />
    </inertial>
  </link>

  <!-- Cockpit Beam 4 -->
  <link name="cockpit_beam_4">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- Wheel 1 -->
  <link name="wheel_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 -1.55 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <!-- Wheel 2 -->
  <link name="wheel_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.55 0" />
      <geometry>
        <!-- <cylinder radius="0.1" length="0.05" /> -->
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <!-- Wheel 3 -->
  <link name="wheel_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 -1.55 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
        <!-- <cylinder radius="0.1" length="0.05" />  -->
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <!-- Wheel 4 -->
  <link name="wheel_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.55 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
        <!-- <cylinder radius="0.1" length="0.05" />  -->
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
  </link>
  

 <!-- kisko 1 -->
  <link name="fork_plate_slider_1">
    <visual>
      <geometry>
        <box size="0.05 0.13 0.75" />
      </geometry>
      
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.13 0.75" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

<!-- kisko 2 -->
  <link name="fork_plate_slider_2">
    <visual>
      <geometry>
        <box size="0.05 0.13 0.75" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
    </visual>
    <collision>
      <geometry>
         <box size="0.05 0.13 0.75" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

    <!-- haarukka 1 -->
  <link name="fork_1">
    <visual>
      <geometry>
        <box size="0.05 0.13 0.5" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
      <origin xyz="0.275 -0.2 -0.2" rpy="0 -1.6 0" />
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.13 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>

      <!-- haarukka 2 -->
  <link name="fork_2">
    <visual>
      <geometry>
        <box size="0.05 0.13 0.5" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
      <origin xyz="0.275 -0.15 -0.2" rpy="0 -1.6 0" />
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.13 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>

      <!-- haarukkakisko -->
  <link name="fork_plate">
    <visual>
      <geometry>
        <box size="0.05 0.45 0.3" />
      </geometry>
      <material name="gray">
        <color rgba="0.388 0.388 0.373 1" />
      </material>
      <origin xyz="0 -0.175 -0.2" rpy="0 0 0"/> 
      </visual>
    <collision>
      <geometry>
        <box size="0.05 0.13 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </link>


   <!-- Base Link -->
  <link name="motor">
    <visual>
      <geometry>
        <box size="0.2 0.6 0.15" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0 0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.8 0.6 0.25" />
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.2" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2" />
    </inertial>
  </link>

  <!-- Connect the fork to the slider-->
  <joint name="motor_to_base" type="fixed">
    <parent link="base_link" />
    <child link="motor" />
    <origin xyz="-0.3 0 0.4" rpy="0 0 0" />
  </joint>


     <!-- Connect the fork 2 to plate-->
  <joint name="fork_2_to_plate" type="fixed">
    <parent link="fork_plate" />
    <child link="fork_2" />
    <origin xyz="0 -0.15 0" rpy="0 0 0" />
  </joint>
    
    <!-- Connect the fork 1 to plate-->
  <joint name="fork_1_to_plate" type="fixed">
    <parent link="fork_plate" />
    <child link="fork_1" />
    <origin xyz="0 0.15 0" rpy="0 0 0" />
  </joint>


    <!-- Joints connecting wheels to base_link -->
  <joint name="fork_slider_2_to_base" type="fixed">
    <parent link="base_link" />
    <child link="fork_plate_slider_2" />
    <origin xyz="0.42 -0.18 0.45" rpy="0 0 0" />
  </joint>

    <!-- Joints connecting wheels to base_link -->
  <joint name="fork_slider_1_to_base" type="fixed">
    <parent link="base_link" />
    <child link="fork_plate_slider_1" />
    <origin xyz="0.42 0.18 0.45" rpy="0 0 0" />
  </joint>


  <!-- Joints connecting base_link to wheels -->
  <joint name="base_to_wheel_1" type="continuous">
    <parent link="base_link" />
    <child link="wheel_1" />
    <origin xyz="0.35 -0.325 0.15" rpy="-1.55 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100000" lower="-6.28318530718" upper="6.28318530718" velocity="2.09439510239" />
  </joint>

  <joint name="base_to_wheel_2" type="continuous">
    <parent link="base_link" />
    <child link="wheel_2" />
    <origin xyz="0.35 0.325 0.15" rpy="-1.55 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="base_to_wheel_3" type="continuous">
    <parent link="base_link" />
    <child link="wheel_3" />
    <origin xyz="-0.35 -0.325 0.15" rpy="-1.55 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="base_to_wheel_4" type="continuous">
    <parent link="base_link" />
    <child link="wheel_4" />
    <origin xyz="-0.35 0.325 0.15" rpy="-1.55 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Joints connecting base_link to cockpit_beam_1 -->
  <joint name="base_to_cockpit_beam_1" type="fixed">
    <parent link="base_link" />
    <child link="cockpit_beam_1" />
    <origin xyz="0.2 -0.2 0.55" rpy="0 -0.4 0" />
  </joint>

  <!-- Joints connecting base_link to cockpit_beam_2 -->
  <joint name="base_to_cockpit_beam_2" type="fixed">
    <parent link="base_link" />
    <child link="cockpit_beam_2" />
    <origin xyz="0.2 0.2 0.55" rpy="0 -0.4 0" />
  </joint>

  <!-- Joints connecting base_link to cockpit_beam_3 -->
  <joint name="base_to_cockpit_beam_3" type="fixed">
    <parent link="base_link" />
    <child link="cockpit_beam_3" />
    <origin xyz="-0.15 0.2 0.55" rpy="0 0 0" />
  </joint>

  <!-- Joints connecting base_link to cockpit_beam_4 -->
  <joint name="base_to_cockpit_beam_4" type="fixed">
    <parent link="base_link" />
    <child link="cockpit_beam_4" />
    <origin xyz="-0.15 -0.2 0.55" rpy="0 0 0" />
  </joint>

  <!-- Joint connecting base_link to roof -->
  <joint name="roof_to_beam" type="fixed">
    <parent link="cockpit_beam_4" />
    <child link="roof" />
    <origin xyz="0.125 0.2 0.25" rpy="0 0 0" />
    <axis xyz="0 1 0"/>
    <limit lower="-0.2" upper="0.25" effort="10000" velocity="50.0"/>
  </joint>

<!-- Connect the fork plate to the slider-->
<joint name="fork_plate_to_slider" type="prismatic">
  <parent link="fork_plate_slider_1" />
  <child link="fork_plate" />
  <origin xyz="0.05 0 0" rpy="0 0 0" />
  <axis xyz="0 0 1"/>
  <limit lower="-0.025" upper="0.5" effort="1000000" velocity="20.0"/>
</joint>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>fork_plate_to_slider</joint_name>
        <topic>fork_control</topic>
        <initial_position>-0.025</initial_position>
    </plugin>
    
    <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_nested_model_pose>false</publish_nested_model_pose>
        </plugin>
    
    <!--
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame></odom_frame>
        <odom_publish_frequency>0.5</odom_publish_frequency>
        <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>
    -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
        <left_joint>base_to_wheel_2</left_joint>
        <left_joint>base_to_wheel_4</left_joint>
        <right_joint>base_to_wheel_1</right_joint>
        <right_joint>base_to_wheel_3</right_joint>
        <wheel_separation>0.7</wheel_separation>
        <wheel_radius>0.4</wheel_radius>
        <odom_publish_frequency>1</odom_publish_frequency>
        <topic>cmd_vel</topic>
      </plugin>
    
</gazebo>  

</robot>
