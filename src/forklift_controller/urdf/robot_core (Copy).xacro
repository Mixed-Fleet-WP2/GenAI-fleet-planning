<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <!-- BASE LINK -->

    <xacro:property name="track_length" value="0.3"/>
    <xacro:property name="track_depth" value="0.02"/> <!--This is actually the depth of the track when in up position-->
    <xacro:property name="track_width" value="0.05"/> <!--This is actually the depth of the track when in up position-->
    <xacro:property name="base_height" value="0.15"/>
    <xacro:property name="base_width" value="0.3"/>
    

    <link name="base_link">

    </link>


    <!-- CHASSIS LINK -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.75"/>
        <axis xyz="0 0 1"/>
        <limit effort="110" lower="0" upper="0.6" velocity="0.5"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="$(find forklift_controller)/meshes/body.dae" scale="0.0027 0.0027 0.0027"/>
                <!-- <box size="0.3 ${base_width} ${base_height}"/> -->
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="0.3 ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="500" x="0.3" y="${base_width}" z="${base_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

  
    <link name="fork_plate">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find forklift_controller)/meshes/fork_plate.dae" scale="0.0027 0.0027 0.0027"/>
                <!-- <box size="0.1 0.25 0.02"/> -->
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find forklift_controller)/meshes/fork_plate.dae" scale="0.0027 0.0027 0.0027"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="10" x="0" y="0" z="0">
            <origin xyz="0.2 0.1 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    
    <joint name="fork_plate_joint" type="prismatic">
        <parent link="chassis"/>
        <child link="fork_plate"/>
        <!--Offset the joint position by the track depth amount-->
        <origin xyz="0.375 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit effort="110" lower="0" upper="0.6" velocity="0.5"/>
    </joint>

    <link name="fork_1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 -${pi}"/>
            <geometry>
                <mesh filename="$(find forklift_controller)/meshes/fork.dae" scale="0.0027 0.0027 0.0027"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
            <geometry>
                <mesh filename="$(find forklift_controller)/meshes/fork.dae" scale="0.0027 0.0027 0.0027"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="10" x="0" y="0" z="0">
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
        </xacro:inertial_box>
    </link>

    <joint name="fork_1_joint" type="fixed">
        <parent link="fork_plate"/>
        <child link="fork_1"/>
        <!--Offset the joint position by the track depth amount-->
        <origin xyz="-0.01 -0.075 -0.03" rpy="0 0 0" />
    </joint>

    <link name="fork_2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
            <geometry>
                <box size="0.05 0.3 0.02"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
            <geometry>
                <box size="0.5 0.25 0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="10" x="0" y="0" z="0">
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
        </xacro:inertial_box>
    </link>

    <joint name="fork_2_joint" type="fixed">
        <parent link="fork_plate"/>
        <child link="fork_2"/>
        <!--Offset the joint position by the track depth amount-->
        <origin xyz="0.154 0.15 0" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit effort="110" lower="0" upper="0.6" velocity="0.5"/>
    </joint>
    


    
    <!-- LEFT WHEEL LINK -->

    <joint name="left_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <origin xyz="0.225 0.125 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel">
        <origin xyz="0 0 3" rpy="0 0 -${pi}"/>
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0 "/>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="left_wheel_back_joint" type="continuous">
        <parent link="chassis"/>
        <child link="left_wheel_back"/>
        <origin xyz="-0.2 0.125 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel_back">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0 "/>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.05">
            <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- RIGHT WHEEL LINK -->

    <joint name="right_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="right_wheel"/>
        <origin xyz="0.225 -0.125 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0 "/>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="right_wheel_back_joint" type="continuous">
        <parent link="chassis"/>
        <child link="right_wheel_back"/>
        <origin xyz="-0.2 -0.125 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_wheel_back">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0 "/>
            <geometry>
                <cylinder radius="0.07" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>

    </link>

   

</robot>