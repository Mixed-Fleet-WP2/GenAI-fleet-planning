<robot name="forklift" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>
  
  <link name="base_footprint">
    <inertial>
        <mass value="0.0001"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
      </visual>
</link>


<joint name="base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
</joint>


<link name="base_link">
    <visual>
        <origin xyz="0 0 0"/>
        <geometry>
            <box size="0.3 0.3 0.2"/>
        </geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0"/>
        <geometry>
            <box size="0.3 0.3 0.2"/>
        </geometry>
    </collision>
    <xacro:inertial_box mass="500" x="0.3" y="0.3" z="0.2">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.07" length="0.05"/>
        </geometry>
        <material name="Cyan">
          <color rgba="0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.07" length="0.05"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1" radius="0.07" length="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.075 ${0.15+0.025} -0.1" rpy="-${3.14/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.07" length="0.05"/>
        </geometry>
        <material name="Cyan">
          <color rgba="0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.07" length="0.05"/>
        </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1" radius="0.07" length="0.05">
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.075 -${0.15+0.025} -0.1" rpy="-${3.14/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <sphere radius="0.07"/>
        </geometry>
        <material name="Cyan">
          <color rgba="0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.07"/>
        </geometry>
    </collision>
    <xacro:inertial_sphere mass="1" radius="0.07">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>
  

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.075 0 -0.1" rpy="0 0 0"/>
  </joint>



  <!--Minimal friction because the caster is fixed-->
  <gazebo reference="caster">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!--
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  -->



  <link name="rplidar_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.01 0.1 0.2"/>
        </geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.01 0.3 0.2"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.001"/>
        <origin xyz="0.005 0.15 0.1" rpy="0 0 0"/>
        <inertia ixx="0.075" ixy="0" ixz="0" iyy="0.075" iyz="0" izz="0.0045"/>
    </inertial>
</link>

<joint name="rplidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
</joint>


<gazebo reference="rplidar_link">
    <sensor name="rplidar" type="gpu_lidar">
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <gz_frame_id>rplidar_link</gz_frame_id>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.164</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <plugin name="dummy" filename="dummyfile"></plugin>
    </sensor>
  </gazebo>

<gazebo reference="rplidar_joint">
<preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<gazebo>
<plugin
  filename="gz-sim-diff-drive-system"
  name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <!-- <left_joint>left_wheel_back_joint</left_joint> -->
      <right_joint>right_wheel_joint</right_joint>
      <!-- <right_joint>right_wheel_back_joint</right_joint> -->
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.07</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <tf_topic>tf</tf_topic>
      <topic>/cmd_vel</topic>
      <child_frame_id>base_link</child_frame_id>

      <max_linear_acceleration>2</max_linear_acceleration>
        <min_linear_acceleration>-2</min_linear_acceleration>
        <max_angular_acceleration>3</max_angular_acceleration>
        <min_angular_acceleration>-3</min_angular_acceleration>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>



  </plugin>

  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>
    <joint_name>caster_joint</joint_name>
      <!-- <topic>$(arg robot_namespace)/joint_states</topic> -->
  </plugin>



</gazebo>



</robot>
